# name: test/sql/inet/test_inet_type.test
# description: Test inet type
# group: [inet]

require inet

statement ok
PRAGMA enable_verification

query I
SELECT '127.0.0.1'::INET::VARCHAR
----
127.0.0.1

query I
SELECT '127.0.0.1/17'::INET::VARCHAR
----
127.0.0.1/17

query I
SELECT '127.0.0.1'::INET
----
127.0.0.1

query I
select '127.000.0000.1'::inet;
----
127.0.0.1

query II
SELECT INET '0.0.0.0/0', INET '255.255.255.255/31'
----
0.0.0.0/0	255.255.255.255/31

query I
SELECT typeof('127.0.0.1/17'::INET)
----
INET

statement error
select '127'::inet;
----
Expected an IP address

statement error
select '127..1'::inet;
----
Expected a number

statement error
SELECT '256.0.0.1'::INET::VARCHAR
----
Expected a number between 0 and 255

statement error
SELECT '-1.0.0.1'::INET::VARCHAR
----
Expected a number

statement error
SELECT '127..0.1'::INET::VARCHAR
----
Expected a number

statement error
SELECT '127.0.0.1/33'::INET::VARCHAR
----
Expected a number between 0 and 32

statement error
SELECT '127.0.0.1/333'::INET::VARCHAR
----
Expected a number between 0 and 32

statement error
SELECT '127.0.0.1/33333333333333333333'::INET::VARCHAR
----
Expected a number between 0 and 32

statement error
SELECT '3,786'::INET;
----
Expected an IP address

statement error
SELECT '1.2.3.4#34'::INET
----
Expected a slash

statement error
SELECT '999.999.999.999/24'::INET
----
Expected a number between 0 and 255

statement ok
CREATE TABLE inet(ip VARCHAR);

statement ok
INSERT INTO inet VALUES ('127.0.0.1'), ('999.999.999.999/24'), ('127.0.0.1/33333333333333333333'), ('255.255.255.255/31')

query I
SELECT TRY_CAST(ip AS INET) FROM inet;
----
127.0.0.1
NULL
NULL
255.255.255.255/31
