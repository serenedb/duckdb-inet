# name: test/sql/inet/test_inet_equality.test
# description: INET equality, grouping and joins compare values directly, only ordering uses inet_sort_key
# group: [inet]

require inet

statement ok
CREATE TABLE ips(id INTEGER, ip INET);

statement ok
INSERT INTO ips VALUES (1, '10.0.0.1'), (2, '10.0.0.5/8'), (3, '10.0.0.1'), (4, '::1'), (5, NULL), (6, '10.0.0.1/32'), (7, '10.0.0.1/8');

query II
EXPLAIN SELECT id FROM ips WHERE ip = '10.0.0.1'
----
physical_plan	<!REGEX>:.*inet_sort_key.*

query II
EXPLAIN SELECT id FROM ips WHERE ip IN ('10.0.0.1', '::1')
----
physical_plan	<!REGEX>:.*inet_sort_key.*

query II
EXPLAIN SELECT ip, count(*) FROM ips GROUP BY ip
----
physical_plan	<!REGEX>:.*(inet_sort_key|first).*

query II
EXPLAIN SELECT DISTINCT ip FROM ips
----
physical_plan	<!REGEX>:.*inet_sort_key.*

query II
EXPLAIN SELECT a.id, b.id FROM ips a JOIN ips b ON a.ip = b.ip
----
physical_plan	<!REGEX>:.*inet_sort_key.*

query II
EXPLAIN SELECT id FROM ips WHERE ip < '10.0.0.1'
----
physical_plan	<REGEX>:.*inet_sort_key.*

query I
SELECT id FROM ips WHERE ip = '10.0.0.1' ORDER BY id
----
1
3
6

query I
SELECT id FROM ips WHERE ip <> '10.0.0.1' ORDER BY id
----
2
4
7

query I
SELECT id FROM ips WHERE ip IN ('10.0.0.1/8', '::1') ORDER BY id
----
4
7

query II
SELECT ip, count(*) FROM ips GROUP BY ip ORDER BY ip NULLS LAST
----
10.0.0.1/8	1
10.0.0.5/8	1
10.0.0.1	3
::1	1
NULL	1

query I
SELECT count(DISTINCT ip) FROM ips
----
4

query II
SELECT a.id, b.id FROM ips a JOIN ips b ON a.ip = b.ip AND a.id < b.id ORDER BY ALL
----
1	3
1	6
3	6

query II
SELECT id, count(*) OVER (PARTITION BY ip) FROM ips ORDER BY id
----
1	3
2	1
3	3
4	1
5	1
6	3
7	1

query I
SELECT ip FROM ips INTERSECT SELECT '10.0.0.1/8'::INET
----
10.0.0.1/8

query I
SELECT id FROM ips WHERE ip IS NOT DISTINCT FROM NULL
----
5

query I
SELECT id FROM ips WHERE ip::CIDR = '10.0.0.0/8' ORDER BY id
----
2
7

query I
SELECT id FROM ips WHERE ip::CIDR IN ('10.0.0.0/8', '::1/128') ORDER BY id
----
2
4
7

query I
SELECT count(*) FROM ips WHERE ip::CIDR::INET = '10.0.0.5/8'
----
0

query I
SELECT count(*) FROM ips WHERE ip::CIDR::INET = '10.0.0.0/8'
----
2
